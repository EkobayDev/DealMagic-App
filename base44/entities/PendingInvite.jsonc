{
  "name": "PendingInvite",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address of the invited user"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of the admin who sent the invite"
    }
  },
  "required": [
    "email",
    "role"
  ]
}